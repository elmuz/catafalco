#################################
# Docker compose configurations #
#################################
COMPOSE_FILE='{{ seafile_compose_files | join(",") }}'
COMPOSE_PATH_SEPARATOR=','

## Images
SEAFILE_IMAGE=seafileltd/seafile-pro-mc:13.0-latest
SEAFILE_DB_IMAGE=mariadb:10.11
SEAFILE_REDIS_IMAGE=redis
SEAFILE_ELASTICSEARCH_IMAGE=elasticsearch:8.15.0
SEAFILE_CADDY_IMAGE=lucaslorentz/caddy-docker-proxy:2.9-alpine
SEADOC_IMAGE=seafileltd/sdoc-server:2.0-latest
NOTIFICATION_SERVER_IMAGE=seafileltd/notification-server:13.0-latest
SEASEARCH_IMAGE=seafileltd/seasearch:1.0-latest
MD_IMAGE=seafileltd/seafile-md-server:13.0-latest


############################################
#   Storage configuration (local and S3)   #
############################################

## Storage type
SEAF_SERVER_STORAGE_TYPE=multiple
ENABLE_STORAGE_CLASSES=true
STORAGE_CLASSES_FILE=/shared/seafile/conf/seafile_storage_classes.json
MD_STORAGE_TYPE=$SEAF_SERVER_STORAGE_TYPE
SS_STORAGE_TYPE=disk

## Local Storage
BASIC_STORAGE_PATH="{{ docker_dir }}/{{ seafile_container_name }}"
SEAFILE_VOLUME=$BASIC_STORAGE_PATH/seafile
SEAFILE_MYSQL_VOLUME=$BASIC_STORAGE_PATH/mysql
SEAFILE_ELASTICSEARCH_VOLUME=$BASIC_STORAGE_PATH/elasticsearch
SEAFILE_CADDY_VOLUME=$BASIC_STORAGE_PATH/caddy
SS_DATA_PATH=$BASIC_STORAGE_PATH/seasearch
SEADOC_VOLUME=$BASIC_STORAGE_PATH/seadoc

## S3 Storage
S3_COMMIT_BUCKET={{ seafile_s3_commit_bucket }}
S3_FS_BUCKET={{ seafile_s3_fs_bucket }}
S3_BLOCK_BUCKET={{ seafile_s3_block_bucket }}
S3_KEY_ID="{{ seafile_s3_key_id }}"
S3_SECRET_KEY="{{ seafile_s3_secret_key }}"
S3_USE_V4_SIGNATURE=true
S3_PATH_STYLE_REQUEST=false
S3_AWS_REGION=eu-central-003
S3_HOST={{ seafile_s3_endpoint }}
S3_USE_HTTPS=true
S3_SSE_C_KEY={{ seafile_s3_sse_c_key }}


#################################
#      Startup parameters       #
#################################
SEAFILE_SERVER_HOSTNAME="{{ seafile_subdomain }}.{{ site_url }}"
SEAFILE_SERVER_PROTOCOL=https
TIME_ZONE="{{ timezone }}"
JWT_PRIVATE_KEY="{{ seafile_jwt_private_key }}"
NON_ROOT=false


#####################################
# Third-party service configuration #
#####################################

## Database
SEAFILE_MYSQL_DB_HOST=db
SEAFILE_MYSQL_DB_USER=seafile
SEAFILE_MYSQL_DB_PASSWORD="{{ seafile_db_user_password }}"
SEAFILE_MYSQL_DB_CCNET_DB_NAME=ccnet_db
SEAFILE_MYSQL_DB_SEAFILE_DB_NAME=seafile_db
SEAFILE_MYSQL_DB_SEAHUB_DB_NAME=seahub_db

## Cache: 'redis' or 'memcached'
CACHE_PROVIDER=redis

## Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD="{{ seafile_redis_password }}"

## Memcached
MEMCACHED_HOST=memcached
MEMCACHED_PORT=11211


######################################
#        Initial variables           #
# (Only valid in first-time startup) #
######################################

## Database root password, Used to create Seafile users
INIT_SEAFILE_MYSQL_ROOT_PASSWORD="{{ seafile_db_user_password }}"

## Seafile admin user
INIT_SEAFILE_ADMIN_EMAIL="{{ email }}"
INIT_SEAFILE_ADMIN_PASSWORD="{{ seafile_admin_password }}"

## SeaSearch admin user (when enabled)
INIT_SS_ADMIN_USER="{{ email }}"
INIT_SS_ADMIN_PASSWORD="{{ seafile_admin_password }}"


############################################
# Additional configurations for extensions #
############################################

## SeaDoc service
ENABLE_SEADOC=false

## SeaSearch
SS_MAX_OBJ_CACHE_SIZE=2GB
SS_LOG_TO_STDOUT=false
SS_LOG_OUTPUT=true
SS_LOG_LEVEL=debug

## Notification
ENABLE_NOTIFICATION_SERVER=true
NOTIFICATION_SERVER_URL="https://{{ seafile_subdomain }}.{{ site_url }}/notification"
INNER_NOTIFICATION_SERVER_URL=http://notification-server:8083

## Seafile AI
ENABLE_SEAFILE_AI=false
SEAFILE_AI_LLM_TYPE=openai
SEAFILE_AI_LLM_URL=
SEAFILE_AI_LLM_KEY= # your llm key
SEAFILE_AI_LLM_MODEL=gpt-4o-mini

## Metadata server
MD_FILE_COUNT_LIMIT=100000

## OnlyOffice
ONLYOFFICE_IMAGE=onlyoffice/documentserver:9.2
ONLYOFFICE_VOLUME=$BASIC_STORAGE_PATH/onlyoffice
ONLYOFFICE_PORT=6233
ONLYOFFICE_JWT_SECRET="{{ onlyoffice_jwt_secret }}"
