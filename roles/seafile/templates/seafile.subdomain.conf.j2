## Version 2026/01/03
server {
{% include "roles/swag/templates/nginx/common.j2" %}

    server_name {{ seafile_subdomain }}.*;

{% if seafile_enable_notification_server is true %}
    location /notification {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        set $upstream_app notification-server;
        set $upstream_port 8083;
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }
{% endif %}
{% if seafile_enable_seasearch is true %}
    location /seasearch/ {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        set $upstream_app seasearch;
        set $upstream_port 4080;
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }
{% endif %}
    location / {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;

        set $upstream_app {{ seafile_container_name }};
        set $upstream_port 80;
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }
}
