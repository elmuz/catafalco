## Version 2024/07/16
server {
{% include "roles/swag/templates/nginx/common.j2" %}

    server_name {{ influxdb_subdomain }}.*;

    location / {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        set $upstream_app {{ influxdb_container_name }};
        set $upstream_port 8181;
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }

    location ~ (/influxdb)?/api {
        # API clients (MCP servers, scripts) need InfluxDB's own JSON error body.
        # errors.conf sets `proxy_intercept_errors on`, which would replace an
        # upstream 500 (e.g. "Schema error: No field named ...") with the themed
        # HTML 5xx page. Keep interception for the browser-facing `location /`.
        proxy_intercept_errors off;
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        set $upstream_app {{ influxdb_container_name }};
        set $upstream_port 8181;
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }
}

server {
{% include "roles/swag/templates/nginx/common.j2" %}

    server_name {{ influxdb_ui_subdomain }}.*;

    location / {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        proxy_hide_header 'Access-Control-Allow-Methods';
        proxy_hide_header 'Access-Control-Allow-Headers';
        proxy_hide_header 'Access-Control-Allow-Origin';
        add_header 'Access-Control-Allow-Origin' '*';
        add_header 'Access-Control-Allow-Methods' 'POST, GET, OPTIONS, PUT, DELETE, PATCH';
        add_header 'Access-Control-Allow-Headers' 'Accept, Content-Type, Content-Length, Accept-Encoding, Authorization, User-Agent';

        set $upstream_app {{ influxdb_container_name }}-explorer;
        set $upstream_port {{ influxdb_ui_port }};
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }
}