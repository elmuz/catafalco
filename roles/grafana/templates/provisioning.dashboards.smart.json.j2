        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "format": "table",
          "rawSql": "SELECT DISTINCT device, model, serial_no FROM smart_attribute WHERE host = '$server' AND time >= $__timeFrom() AND time <= $__timeTo() ORDER BY device",
          "refId": "A"
