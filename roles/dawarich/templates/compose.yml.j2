networks:
  dawarich_network:
    name: "{{ dawarich_network_name }}"
    external: true

services:
  redis:
    image: redis:7.4-alpine
    container_name: "{{ dawarich_container_name }}-redis"
    command: redis-server
    networks:
      - dawarich_network
    volumes:
      - {{ docker_dir }}/{{ dawarich_container_name }}/redis_data:/data
    restart: always
    healthcheck:
      test: [ "CMD", "redis-cli", "--raw", "incr", "ping" ]
      interval: 10s
      retries: 5
      start_period: 30s
      timeout: 10s

  db:
    image: postgis/postgis:17-3.5-alpine
    shm_size: 1G
    container_name: "{{ dawarich_container_name }}-db"
    volumes:
      - {{ docker_dir }}/{{ dawarich_container_name }}/db_data:/var/lib/postgresql/data
    networks:
      - dawarich_network
    environment:
      POSTGRES_USER: "{{ dawarich_postgres_username }}"
      POSTGRES_PASSWORD: "{{ dawarich_postgres_password }}"
      POSTGRES_DB: dawarich_production
    restart: unless-stopped
    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -U {{ dawarich_postgres_username }} -d dawarich_production" ]
      interval: 10s
      retries: 5
      start_period: 30s
      timeout: 10s

  dawarich:
    image: freikin/dawarich:{{ dawarich_version }}
    container_name: "{{ dawarich_container_name }}"
    volumes:
      - {{ docker_dir }}/{{ dawarich_container_name }}/public:/var/app/public
      - {{ docker_dir }}/{{ dawarich_container_name }}/watched:/var/app/tmp/imports/watched
      - {{ docker_dir }}/{{ dawarich_container_name }}/storage:/var/app/storage
      - {{ docker_dir }}/{{ dawarich_container_name }}/db_data:/dawarich_db_data
    networks:
      - dawarich_network
    expose:
      - 3000
    stdin_open: true
    tty: true
    entrypoint: web-entrypoint.sh
    command: ['bin/rails', 'server', '-p', '3000', '-b', '::']
    restart: unless-stopped
    environment:
      RAILS_ENV: production
      REDIS_URL: redis://redis:6379
      DATABASE_HOST: db
      DATABASE_PORT: 5432
      DATABASE_USERNAME: "{{ dawarich_postgres_username }}"
      DATABASE_PASSWORD: "{{ dawarich_postgres_password }}"
      DATABASE_NAME: dawarich_production
      MIN_MINUTES_SPENT_IN_CITY: 60
      APPLICATION_HOSTS: "{{ dawarich_subdomain }}.{{ site_url }},127.0.0.1"
      TIME_ZONE: "{{ timezone }}"
      APPLICATION_PROTOCOL: http
      DISTANCE_UNIT: km
      REVERSE_GEOCODING_ENABLED: "true"
      SECRET_KEY_BASE: "{{ dawarich_secret_key_base }}"
      SELF_HOSTED: "true"
      STORE_GEODATA: "true"
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "5"
    healthcheck:
      test: [ "CMD-SHELL", "wget -qO - http://127.0.0.1:3000/api/v1/health | grep -q '\"status\"\\s*:\\s*\"ok\"'" ]
      interval: 5m
      retries: 5
      start_period: 30s
      timeout: 10s
    depends_on:
      db:
        condition: service_healthy
        restart: true
      redis:
        condition: service_healthy
        restart: true
    # labels:
    #  swag.uptime-kuma.enabled: "true"
    #  swag.uptime-kuma.monitor.name: "{{ dawarich_dashboard_name }}"
    #  swag.uptime-kuma.monitor.url: "{{ dawarich_dashboard_url }}"
    #  swag.uptime-kuma.monitor.maxretries: "2"
    deploy:
      resources:
        limits:
          cpus: "0.50"
          memory: "4G"

  sidekiq:
    image: freikin/dawarich:{{ dawarich_version }}
    container_name: dawarich-sidekiq
    volumes:
      - {{ docker_dir }}/{{ dawarich_container_name }}/public:/var/app/public
      - {{ docker_dir }}/{{ dawarich_container_name }}/watched:/var/app/tmp/imports/watched
      - {{ docker_dir }}/{{ dawarich_container_name }}/storage:/var/app/storage
    networks:
      - dawarich_network
    stdin_open: true
    tty: true
    entrypoint: sidekiq-entrypoint.sh
    command: ['bundle', 'exec', 'sidekiq']
    restart: on-failure
    environment:
      RAILS_ENV: production
      REDIS_URL: redis://redis:6379
      DATABASE_HOST: db
      DATABASE_PORT: 5432
      DATABASE_USERNAME: "{{ dawarich_postgres_username }}"
      DATABASE_PASSWORD: "{{ dawarich_postgres_password }}"
      DATABASE_NAME: dawarich_production
      APPLICATION_HOSTS: localhost,::1,127.0.0.1
      BACKGROUND_PROCESSING_CONCURRENCY: 10
      APPLICATION_PROTOCOL: http
      PROMETHEUS_EXPORTER_ENABLED: false
      PROMETHEUS_EXPORTER_HOST: dawarich
      PROMETHEUS_EXPORTER_PORT: 9394
      SELF_HOSTED: "true"
      SECRET_KEY_BASE: 1234567890
      RAILS_LOG_TO_STDOUT: "true"
      STORE_GEODATA: "true"
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "5"
    healthcheck:
      test: [ "CMD-SHELL", "pgrep -f sidekiq" ]
      interval: 10s
      retries: 30
      start_period: 30s
      timeout: 10s
    depends_on:
      db:
        condition: service_healthy
        restart: true
      redis:
        condition: service_healthy
        restart: true
      dawarich:
        condition: service_healthy
        restart: true
